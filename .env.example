# Discord Bot Token (From Discord Developer Portal)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Discord Server (Guild) ID
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID_HERE

# Discord Webhook Notification URL (Optional, for daily scan channel alert)
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL_HERE

# Discord Owner User ID (Optional, restricts admin commands & private DM reports)
DISCORD_OWNER_ID=YOUR_DISCORD_USER_ID_HERE

# Notification Privacy & Mode (Optional)
DISCORD_NOTIFY_PRIVATE=true
DISCORD_SEND_PUBLIC_WEBHOOK=false
DISCORD_WEBHOOK_INCLUDE_PORTFOLIO=false

# Scanner Overrides (Optional)
# PORTFOLIO_CASH_THB=5000
# SCAN_PHASE=trading

# Supabase Cloud Persistence (Server-side only: use Secret / service_role key; NEVER expose in frontend)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY

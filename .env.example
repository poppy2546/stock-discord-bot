# Discord Bot Token (From Discord Developer Portal)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Discord Server (Guild) ID
DISCORD_GUILD_ID=YOUR_DISCORD_GUILD_ID_HERE

# Discord Webhook Notification URL (Optional, for daily scan channel alert)
DISCORD_WEBHOOK_URL=YOUR_DISCORD_WEBHOOK_URL_HERE

# Discord Owner User ID (Optional, restricts /portfolio and !port to owner only)
DISCORD_OWNER_ID=YOUR_DISCORD_USER_ID_HERE

# Supabase Cloud Persistence (Recommended for Render Free Tier so user data never resets on redeploy)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_ROLE_OR_ANON_KEY
